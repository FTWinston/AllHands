{
  "extends": "../../tsconfig.vite.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./dist",
    "emitDeclarationOnly": true,
    "paths": {
      "common-data/*": ["../common-data/src/*"],
      "engine/*": ["../engine/src/*"],
      "common-ui/*": ["./src/*"],
      "content/*": ["../../content/*"],
    }
  },
  "include": ["src", "../../content/**/*.ui.ts", "../../content/**/*.ui.tsx", "../../content/**/*.test.tsx"],
  "references": [
    { "path": "../common-data" },
    { "path": "../engine" }
  ]
}
